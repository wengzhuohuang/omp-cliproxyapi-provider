    "url": "git+https://github.com/wengzhuohuang/omp-cliproxyapi-provider.git"
  },
  "homepage": "https://github.com/wengzhuohuang/omp-cliproxyapi-provider#readme",
  "bugs": {
    "url": "https://github.com/wengzhuohuang/omp-cliproxyapi-provider/issues"
  },
